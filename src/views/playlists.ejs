<%- include('partials/header') %>

<div class="page-header">
  <h1>Playlists</h1>
</div>

<div class="card">
  <h2>Create a playlist</h2>
  <form method="POST" action="/playlists/create" class="form-inline">
    <div class="form-group">
      <input type="text" name="name" placeholder="Playlist name" required>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
  </form>
</div>

<div class="card">
  <h2>Create a smart playlist</h2>
  <form method="POST" action="/playlists/create-smart" class="smart-playlist-form">
    <div class="form-row">
      <div class="form-group">
        <label>Name</label>
        <input type="text" name="name" placeholder="Smart playlist name" required>
      </div>
      <div class="form-group">
        <label>Tag</label>
        <input type="text" name="tag" placeholder="Filter by tag">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Min duration (sec)</label>
        <input type="number" name="minDuration" placeholder="e.g. 300">
      </div>
      <div class="form-group">
        <label>Max duration (sec)</label>
        <input type="number" name="maxDuration" placeholder="e.g. 3600">
      </div>
      <div class="form-group">
        <label>Resolution</label>
        <select name="resolution">
          <option value="">Any</option>
          <option value="4k">4K</option>
          <option value="1080p">1080p</option>
          <option value="720p">720p</option>
          <option value="sd">SD</option>
        </select>
      </div>
      <div class="form-group">
        <label>Sort by</label>
        <select name="sort">
          <option value="name">Name</option>
          <option value="date">Date</option>
          <option value="size">Size</option>
          <option value="duration">Duration</option>
        </select>
      </div>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
  </form>
</div>

<% if (playlists.length === 0) { %>
  <div class="empty-state">
    <p>No playlists yet. Create one to organise your videos.</p>
  </div>
<% } else { %>
  <div class="libraries-grid">
    <% for (const pl of playlists) { %>
      <div class="card library-card">
        <div class="library-info">
          <h3><a href="/playlists/<%= pl.id %>"><%= pl.name %></a> <% if (pl.is_smart) { %><span class="badge badge-accent">Smart</span><% } %></h3>
          <p class="library-count"><%= pl.item_count || 0 %> video(s)</p>
        </div>
        <div class="library-actions">
          <a href="/playlists/<%= pl.id %>" class="btn btn-sm">Open</a>
          <form method="POST" action="/playlists/<%= pl.id %>/delete" style="display:inline"
                onsubmit="return confirm('Delete this playlist?')">
            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
          </form>
        </div>
      </div>
    <% } %>
  </div>
<% } %>

<%- include('partials/footer') %>
