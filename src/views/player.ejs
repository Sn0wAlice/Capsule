<%- include('partials/header') %>

<%
function formatSize(bytes) {
  bytes = Number(bytes);
  if (!bytes || Number.isNaN(bytes)) return '—';
  const units = ['B', 'KB', 'MB', 'GB', 'TB'];
  let i = 0;
  let size = bytes;
  while (size >= 1024 && i < units.length - 1) { size /= 1024; i++; }
  return size.toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
}
function formatDuration(seconds) {
  if (!seconds) return '—';
  const h = Math.floor(seconds / 3600);
  const m = Math.floor((seconds % 3600) / 60);
  const s = Math.floor(seconds % 60);
  if (h > 0) return h + 'h ' + String(m).padStart(2, '0') + 'm ' + String(s).padStart(2, '0') + 's';
  return m + 'm ' + String(s).padStart(2, '0') + 's';
}
function formatBitrate(bps) {
  if (!bps) return '—';
  if (bps >= 1000000) return (bps / 1000000).toFixed(1) + ' Mbps';
  return (bps / 1000).toFixed(0) + ' kbps';
}
%>

<div class="player-page">
  <!-- Breadcrumb -->
  <div class="player-breadcrumb">
    <a href="/dashboard">Libraries</a>
    <span class="separator">/</span>
    <a href="/libraries/<%= video.library_id %>"><%= video.library_name %></a>
    <% for (const crumb of breadcrumb) { %>
      <span class="separator">/</span>
      <a href="/libraries/<%= video.library_id %>?view=folder&path=<%= encodeURIComponent(crumb.path) %>"><%= crumb.name %></a>
    <% } %>
    <span class="separator">/</span>
    <span class="current"><%= video.filename %></span>
  </div>

  <div class="player-layout">
    <!-- Left: Video Player -->
    <div class="player-main">
      <div class="player-container">
        <div id="artplayer-app"></div>
      </div>
      <div class="player-title-bar">
        <h1 class="player-title" id="video-title"<% if (['owner','admin','write'].includes(permission)) { %> title="Double-click to rename"<% } %>><%= video.title || video.filename %></h1>
        <div class="player-actions">
          <button class="btn btn-sm btn-fav<%= isFavorite ? ' active' : '' %>" id="btn-fav" title="Favourite (F)">
            <span id="fav-icon"><%- isFavorite ? '&#9733;' : '&#9734;' %></span>
          </button>
          <button class="btn btn-sm btn-wl<%= isWatchlisted ? ' active' : '' %>" id="btn-wl" title="Watchlist (W)">
            <span id="wl-icon"><%- isWatchlisted ? '&#10003;' : '&#9201;' %></span>
          </button>
          <a href="/videos/<%= video.id %>/download" class="btn btn-sm" title="Download" download>&#8595; Download</a>
          <% if (['owner','admin','write'].includes(permission)) { %>
          <button class="btn btn-sm" id="btn-reprocess" title="Rebuild thumbnail and metadata">&#8635; Reprocess</button>
          <button class="btn btn-sm btn-danger" id="btn-delete" title="Remove from library">&#128465; Delete</button>
          <% } %>
          <% if (playlists.length > 0) { %>
          <select id="add-to-playlist" class="autoplay-select" title="Add to a playlist">
            <option value="">+ Playlist</option>
            <% for (const pl of playlists) { %>
              <option value="<%= pl.id %>"><%= pl.name %></option>
            <% } %>
          </select>
          <% } %>
          <div class="autoplay-control">
            <span class="autoplay-label">Auto</span>
            <select id="autoplay-mode" class="autoplay-select">
              <option value="off">Off</option>
              <option value="random">Random</option>
              <option value="alpha">A-Z</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Tags -->
      <div class="tags-bar">
        <div class="tags-list" id="tags-list">
          <% for (const tag of tags) { %>
            <span class="tag tag-<%= tag.color %>" data-id="<%= tag.id %>">
              <a href="/videos?tag=<%= encodeURIComponent(tag.name) %>" class="tag-link"><%= tag.name %></a>
              <% if (['owner','admin','write'].includes(permission)) { %>
                <button class="tag-remove" data-id="<%= tag.id %>">&times;</button>
              <% } %>
            </span>
          <% } %>
        </div>
        <% if (['owner','admin','write'].includes(permission)) { %>
        <form class="tag-add-form" id="tag-form">
          <input type="text" id="tag-input" placeholder="+ tag" autocomplete="off">
        </form>
        <% } %>
      </div>

      <!-- Description (below video, in player-main) -->
      <% const canWrite = ['owner','admin','write'].includes(permission); %>
      <% if (canWrite || video.description) { %>
      <div class="video-description-block" id="desc-block">
        <% if (video.description) { %>
          <!-- Existing description -->
          <div class="desc-display" id="desc-display">
            <p class="desc-text" id="desc-text"><%= video.description %></p>
            <% if (canWrite) { %>
            <button class="desc-edit-btn" id="desc-edit-btn" title="Edit description">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              Edit
            </button>
            <% } %>
          </div>
        <% } %>

        <% if (canWrite) { %>
        <!-- Editor (hidden when a description already exists) -->
        <div class="desc-editor" id="desc-editor" style="<%= video.description ? 'display:none' : '' %>">
          <textarea
            id="video-description"
            class="desc-textarea"
            placeholder="Add a description…"
            rows="3"
          ><%= video.description || '' %></textarea>
          <div class="desc-editor-actions">
            <button class="btn btn-sm btn-primary" id="btn-save-desc">Save</button>
            <% if (video.description) { %>
            <button class="btn btn-sm" id="desc-cancel-btn">Cancel</button>
            <% } %>
          </div>
        </div>
        <% } %>

        <% if (!video.description && !canWrite) { %>
          <!-- Nothing to show for read-only viewers when there is no description -->
        <% } %>
      </div>
      <% } %>
    </div>

    <!-- Right: Info Panel -->
    <div class="player-sidebar">
      <div class="sidebar-section">
        <h3>Information</h3>
        <div class="info-row">
          <span class="info-label">File</span>
          <span class="info-value"><%= video.filename %></span>
        </div>
        <div class="info-row">
          <span class="info-label">Path</span>
          <span class="info-value mono"><%= video.filepath %></span>
        </div>
        <div class="info-row">
          <span class="info-label">Library</span>
          <span class="info-value"><%= video.library_name %></span>
        </div>
        <% if (video.duration) { %>
        <div class="info-row">
          <span class="info-label">Duration</span>
          <span class="info-value"><%= formatDuration(video.duration) %></span>
        </div>
        <% } %>
        <% if (video.size) { %>
        <div class="info-row">
          <span class="info-label">Size</span>
          <span class="info-value"><%= formatSize(video.size) %></span>
        </div>
        <% } %>
        <% if (video.width && video.height) { %>
        <div class="info-row">
          <span class="info-label">Resolution</span>
          <span class="info-value"><%= video.width %>×<%= video.height %></span>
        </div>
        <% } %>
        <% if (video.codec) { %>
        <div class="info-row">
          <span class="info-label">Video codec</span>
          <span class="info-value mono"><%= video.codec %></span>
        </div>
        <% } %>
        <% if (video.audio_codec) { %>
        <div class="info-row">
          <span class="info-label">Audio codec</span>
          <span class="info-value mono"><%= video.audio_codec %></span>
        </div>
        <% } %>
        <%
          let audioTracks = null;
          try {
            audioTracks = video.audio_tracks ? (typeof video.audio_tracks === 'string' ? JSON.parse(video.audio_tracks) : video.audio_tracks) : null;
          } catch(e) {}
        %>
        <% if (audioTracks && audioTracks.length > 1) { %>
        <div class="info-row">
          <span class="info-label">Audio tracks</span>
          <span class="info-value">
            <% for (const track of audioTracks) { %>
              <span class="badge badge-info" style="margin: 1px 2px; display: inline-block;">
                <%= track.language || ('Track ' + track.index) %><% if (track.title) { %> — <%= track.title %><% } %> (<%= track.codec %>)
              </span>
            <% } %>
          </span>
        </div>
        <% } %>
        <% if (video.bitrate) { %>
        <div class="info-row">
          <span class="info-label">Bitrate</span>
          <span class="info-value"><%= formatBitrate(video.bitrate) %></span>
        </div>
        <% } %>
        <% if (video.mime_type) { %>
        <div class="info-row">
          <span class="info-label">Type</span>
          <span class="info-value mono"><%= video.mime_type %></span>
        </div>
        <% } %>
        <div class="info-row">
          <span class="info-label">Added</span>
          <span class="info-value"><%= new Date(video.created_at).toLocaleDateString('en-GB') %></span>
        </div>
      </div>


      <div class="sidebar-section sidebar-shortcuts">
        <h3>Shortcuts</h3>
        <div class="shortcut-row"><kbd>F</kbd> <span>Favourite</span></div>
        <div class="shortcut-row"><kbd>W</kbd> <span>Watchlist</span></div>
        <div class="shortcut-row"><kbd>N</kbd> <span>Next video</span></div>
        <div class="shortcut-row"><kbd>L</kbd> <span>Fullscreen</span></div>
        <div class="shortcut-row"><kbd>M</kbd> <span>Autoplay mode</span></div>
        <% if (['owner','admin','write'].includes(permission)) { %>
        <div class="shortcut-row"><kbd>T</kbd> <span>Add a tag</span></div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Similar Videos -->
  <% if (similar.length > 0) { %>
  <div class="similar-section">
    <h2>More from this library</h2>
    <div class="video-grid">
      <% for (const v of similar) { %>
        <a href="/videos/<%= v.id %>" class="video-card">
          <div class="video-card-preview">
            <% if (v.thumb) { %>
              <img src="/videos/<%= v.id %>/thumb" alt="" loading="lazy">
            <% } %>
          </div>
          <div class="video-card-info">
            <span class="video-card-title"><%= v.title || v.filename %></span>
            <span class="video-card-meta"><%= formatSize(v.size) %></span>
          </div>
        </a>
      <% } %>
    </div>
  </div>
  <% } %>
</div>

<script src="/vendor/artplayer/artplayer.js?v=<%= vendorVersion %>"></script>
<script>
  const VIDEO_ID = <%= video.id %>;
  const LIBRARY_ID = <%= video.library_id %>;
  const SAVED_PROGRESS = <%= savedProgress %>;
  const CAN_WRITE = <%= ['owner','admin','write'].includes(permission) %>;
  <%
    let audioTracksJs = null;
    try { audioTracksJs = video.audio_tracks ? (typeof video.audio_tracks === 'string' ? JSON.parse(video.audio_tracks) : video.audio_tracks) : null; } catch(e) {}
  %>
  const AUDIO_TRACKS = <%- JSON.stringify(audioTracksJs || []) %>;
  const SUBTITLES = <%- JSON.stringify(subtitles.map(s => ({ label: s.label, language: s.language, url: '/videos/' + video.id + '/subtitles/' + encodeURIComponent(s.filename) }))) %>;

  // Restore autoplay mode from localStorage
  const autoplaySelect = document.getElementById('autoplay-mode');
  const savedMode = localStorage.getItem('capsule_autoplay') || 'off';
  autoplaySelect.value = savedMode;
  autoplaySelect.addEventListener('change', () => {
    localStorage.setItem('capsule_autoplay', autoplaySelect.value);
  });

  // Restore saved playback rate + volume
  // Note: muted state is NEVER persisted — every session starts with sound on
  const savedRate   = parseFloat(localStorage.getItem('capsule_playback_rate')) || 1;
  const savedVolume = parseFloat(localStorage.getItem('capsule_volume'))        || 0.7;
  // Clear any stale value written by an earlier version
  localStorage.removeItem('capsule_muted');

  // Init ArtPlayer
  const artConfig = {
    container: '#artplayer-app',
    url: '/videos/' + VIDEO_ID + '/stream',
    type: '<%= video.mime_type === "video/x-matroska" ? "mkv" : "" %>',
    volume: savedVolume,
    autoSize: false,
    autoMini: true,
    loop: false,
    flip: true,
    playbackRate: true,
    aspectRatio: true,
    setting: true,
    hotkey: true,
    pip: true,
    mutex: true,
    fullscreen: true,
    fullscreenWeb: true,
    miniProgressBar: true,
    playsInline: true,
    theme: getComputedStyle(document.documentElement).getPropertyValue('--foreground').trim() || '#fafafa',
    // Disable ArtPlayer's auto-playback plugin, which restores the position from
    // localStorage — that was the 00:05 start. We drive the position via SAVED_PROGRESS.
    autoPlayback: false,
    controls: [
      {
        position: 'right',
        html: '<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/><rect x="4" y="5" width="2" height="14" rx="1"/></svg>',
        tooltip: 'Next video (N)',
        click: function () { goNext(); },
      },
    ],
  };
  // Inject subtitle tracks if available
  if (SUBTITLES.length > 0) {
    artConfig.subtitle = {
      url: SUBTITLES[0].url,
      type: SUBTITLES[0].url.endsWith('.vtt') ? 'vtt' : 'srt',
      style: { color: '#fff', 'font-size': '20px' },
      encoding: 'utf-8',
    };
    if (SUBTITLES.length > 1) {
      artConfig.settings = [{
        html: 'Sous-titres',
        width: 200,
        tooltip: SUBTITLES[0].label,
        selector: SUBTITLES.map((s, i) => ({ html: s.label, default: i === 0, url: s.url })),
        onSelect: function(item) {
          art.subtitle.url = item.url;
          return item.html;
        },
      }];
    }
  }
  const art = new Artplayer(artConfig);

  // Resize container to match video aspect ratio
  art.on('video:loadedmetadata', () => {
    const { videoWidth, videoHeight } = art.video;
    if (videoWidth && videoHeight) {
      const container = document.getElementById('artplayer-app');
      const w = container.clientWidth;
      const h = Math.min(w * videoHeight / videoWidth, window.innerHeight * 0.8);
      container.style.height = h + 'px';
      art.autoSize = false;
    }
  });

  // Resume playback + auto-start if navigated via autoplay
  const urlParams = new URLSearchParams(window.location.search);
  const shouldAutoplay = urlParams.get('autoplay') === '1';

  art.on('ready', () => {
    if (savedRate !== 1) art.playbackRate = savedRate;

    // Resume where we left off (SAVED_PROGRESS is 0 on autoplay, see the server route)
    if (SAVED_PROGRESS > 2) {
      art.currentTime = SAVED_PROGRESS;
    }

    if (shouldAutoplay) {
      const p = art.play();
      if (p && typeof p.catch === 'function') {
        p.catch(() => {
          // The browser blocked autoplay with sound → mute and show the overlay
          art.muted = true;
          art.play().catch(() => {});
          showUnmuteOverlay();
        });
      }
    }
  });

  // Save progress every 5 seconds
  let lastSaved = 0;
  art.on('video:timeupdate', () => {
    const now = Date.now();
    if (now - lastSaved > 5000) {
      lastSaved = now;
      fetch('/videos/' + VIDEO_ID + '/progress', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ progress: art.currentTime }),
      }).catch(() => {});
    }
  });

  // Save on pause/close
  function saveProgress() {
    if (art.currentTime > 0) {
      // keepalive: true survives page unload like sendBeacon, but still goes through
      // the fetch interceptor so the CSRF token is injected
      fetch('/videos/' + VIDEO_ID + '/progress', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ progress: art.currentTime }),
        keepalive: true,
      }).catch(() => {});
    }
  }
  art.on('video:pause', saveProgress);
  window.addEventListener('beforeunload', saveProgress);

  // "Click to unmute" overlay, shown when the browser blocks autoplay with sound
  function showUnmuteOverlay() {
    const container = document.getElementById('artplayer-app');
    if (!container || document.getElementById('unmute-overlay')) return;

    const overlay = document.createElement('div');
    overlay.id = 'unmute-overlay';
    overlay.innerHTML =
      '<div class="unmute-inner">' +
        '<svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">' +
          '<path d="M16.5 12A4.5 4.5 0 0 0 14 7.97v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.796 8.796 0 0 0 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3 3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06A8.99 8.99 0 0 0 17.73 18L19 19.27 20.27 18 5.27 3 4.27 3zM12 4 9.91 6.09 12 8.18V4z"/>' +
        '</svg>' +
        '<span>Click to unmute</span>' +
      '</div>';

    overlay.addEventListener('click', () => {
      art.muted = false;
      art.volume = savedVolume;
      overlay.remove();
    });

    container.style.position = 'relative';
    container.appendChild(overlay);
  }

  // Persist playback rate + volume (never the muted flag — see the note above)
  art.on('video:ratechange', () => {
    localStorage.setItem('capsule_playback_rate', art.playbackRate);
  });
  art.on('video:volumechange', () => {
    // Persist the volume level only, never the muted flag, so a browser-forced mute
    // does not leak into the user's preferences
    if (art.volume > 0) {
      localStorage.setItem('capsule_volume', art.volume);
    }
  });

  // Auto-play next on video end
  art.on('video:ended', () => {
    const mode = autoplaySelect.value;
    if (mode === 'off') return;
    fetch('/videos/' + VIDEO_ID + '/next?mode=' + mode)
      .then(r => r.json())
      .then(data => {
        if (data.id) window.location.href = '/videos/' + data.id + '?autoplay=1';
      })
      .catch(() => {});
  });

  // Go to next video
  function goNext() {
    const mode = autoplaySelect.value === 'off' ? 'random' : autoplaySelect.value;
    fetch('/videos/' + VIDEO_ID + '/next?mode=' + mode)
      .then(r => r.json())
      .then(data => {
        if (data.id) window.location.href = '/videos/' + data.id + '?autoplay=1';
      })
      .catch(() => {});
  }

  // Toggle favorite
  const btnFav = document.getElementById('btn-fav');
  const favIcon = document.getElementById('fav-icon');
  function toggleFav() {
    fetch('/videos/' + VIDEO_ID + '/favorite', { method: 'POST' })
      .then(r => r.json())
      .then(data => {
        favIcon.innerHTML = data.favorited ? '&#9733;' : '&#9734;';
        btnFav.classList.toggle('active', data.favorited);
      })
      .catch(() => {});
  }
  btnFav.addEventListener('click', toggleFav);

  // Toggle watchlist
  const btnWl = document.getElementById('btn-wl');
  const wlIcon = document.getElementById('wl-icon');
  function toggleWl() {
    fetch('/videos/' + VIDEO_ID + '/watchlist', { method: 'POST' })
      .then(r => r.json())
      .then(data => {
        wlIcon.innerHTML = data.watchlisted ? '&#10003;' : '&#9201;';
        btnWl.classList.toggle('active', data.watchlisted);
      })
      .catch(() => {});
  }
  btnWl.addEventListener('click', toggleWl);

  // Cycle autoplay mode
  function cycleAutoplay() {
    const modes = ['off', 'random', 'alpha'];
    const idx = modes.indexOf(autoplaySelect.value);
    autoplaySelect.value = modes[(idx + 1) % modes.length];
    localStorage.setItem('capsule_autoplay', autoplaySelect.value);
  }

  // Inline rename (double-click title)
  const titleEl = document.getElementById('video-title');
  if (CAN_WRITE) titleEl.addEventListener('dblclick', () => {
    const current = titleEl.textContent.trim();
    const input = document.createElement('input');
    input.type = 'text';
    input.value = current;
    input.className = 'rename-input';
    titleEl.replaceWith(input);
    input.focus();
    input.select();

    function save() {
      const newTitle = input.value.trim();
      fetch('/videos/' + VIDEO_ID + '/rename', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title: newTitle }),
      }).then(r => r.json()).then(data => {
        titleEl.textContent = data.title || '<%= video.filename.replace(/'/g, "\\'") %>';
        input.replaceWith(titleEl);
      }).catch(() => {
        titleEl.textContent = current;
        input.replaceWith(titleEl);
      });
    }
    input.addEventListener('blur', save);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
      if (e.key === 'Escape') { titleEl.textContent = current; input.replaceWith(titleEl); }
    });
  });

  // Tags
  const tagsList = document.getElementById('tags-list');
  const tagForm = document.getElementById('tag-form');
  const tagInput = document.getElementById('tag-input');

  if (CAN_WRITE && tagForm) tagForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = tagInput.value.trim();
    if (!name) return;
    fetch('/videos/' + VIDEO_ID + '/tags', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name }),
    }).then(r => r.json()).then(data => {
      if (data.tag) {
        const span = document.createElement('span');
        span.className = 'tag tag-' + data.tag.color.replace(/[^a-z]/g, '');
        span.dataset.id = data.tag.id;
        span.textContent = data.tag.name + ' ';
        const btn = document.createElement('button');
        btn.className = 'tag-remove';
        btn.dataset.id = data.tag.id;
        btn.textContent = '\u00d7';
        span.appendChild(btn);
        tagsList.appendChild(span);
        tagInput.value = '';
      }
    }).catch(() => {});
  });

  if (CAN_WRITE) tagsList.addEventListener('click', (e) => {
    if (e.target.classList.contains('tag-remove')) {
      const tagId = e.target.dataset.id;
      fetch('/videos/' + VIDEO_ID + '/tags/' + tagId, { method: 'DELETE' })
        .then(r => r.json())
        .then(() => {
          e.target.parentElement.remove();
        })
        .catch(() => {});
    }
  });

  // Add to playlist
  const playlistSelect = document.getElementById('add-to-playlist');
  if (playlistSelect) {
    playlistSelect.addEventListener('change', () => {
      const plId = playlistSelect.value;
      if (!plId) return;
      fetch('/playlists/' + plId + '/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ video_id: VIDEO_ID }),
      }).then(r => r.json()).then(() => {
        playlistSelect.value = '';
      }).catch(() => {});
    });
  }

  // Delete video
  const btnDelete = document.getElementById('btn-delete');
  if (btnDelete) {
    btnDelete.addEventListener('click', () => {
      if (!confirm('Remove this video from the library? (the file stays on disk)')) return;
      fetch('/videos/' + VIDEO_ID + '/delete', { method: 'POST' })
        .then(r => r.json())
        .then(data => {
          if (data.ok) window.location.href = '/libraries/' + LIBRARY_ID;
          else alert('Error: ' + (data.error || 'unknown'));
        })
        .catch(() => alert('Network error'));
    });
  }

  // Re-process video
  const btnReprocess = document.getElementById('btn-reprocess');
  if (btnReprocess) {
    btnReprocess.addEventListener('click', () => {
      if (!confirm('Reprocess this video (thumbnail and metadata)?')) return;
      btnReprocess.disabled = true;
      btnReprocess.textContent = '⏳ En cours...';
      fetch('/videos/' + VIDEO_ID + '/reprocess', { method: 'POST' })
        .then(r => r.json())
        .then(data => {
          if (data.ok) {
            btnReprocess.textContent = '✓ Queued';
            setTimeout(() => { btnReprocess.disabled = false; btnReprocess.innerHTML = '&#8635; Retraiter'; }, 3000);
          } else {
            btnReprocess.disabled = false;
            btnReprocess.innerHTML = '&#8635; Retraiter';
            alert('Error: ' + (data.error || 'unknown'));
          }
        })
        .catch(() => { btnReprocess.disabled = false; btnReprocess.innerHTML = '&#8635; Retraiter'; });
    });
  }

  // Description — save + toggle edit/display
  const btnSaveDesc   = document.getElementById('btn-save-desc');
  const descTextarea  = document.getElementById('video-description');
  const descDisplay   = document.getElementById('desc-display');
  const descEditor    = document.getElementById('desc-editor');
  const descText      = document.getElementById('desc-text');
  const descEditBtn   = document.getElementById('desc-edit-btn');
  const descCancelBtn = document.getElementById('desc-cancel-btn');

  function showEditor() {
    if (descDisplay) descDisplay.style.display = 'none';
    if (descEditor)  descEditor.style.display = '';
    if (descTextarea) descTextarea.focus();
  }
  function showDisplay(newText) {
    if (descText) descText.textContent = newText;
    if (descDisplay) descDisplay.style.display = '';
    if (descEditor)  descEditor.style.display = 'none';
  }

  if (descEditBtn)   descEditBtn.addEventListener('click', showEditor);
  if (descCancelBtn) descCancelBtn.addEventListener('click', () => {
    if (descTextarea) descTextarea.value = descText ? descText.textContent : '';
    showDisplay(descText ? descText.textContent : '');
  });

  if (btnSaveDesc && descTextarea) {
    btnSaveDesc.addEventListener('click', () => {
      const val = descTextarea.value.trim();
      btnSaveDesc.disabled = true;
      fetch('/videos/' + VIDEO_ID + '/description', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ description: val }),
      }).then(r => r.json()).then(data => {
        if (data.ok) {
          // Show the saved description
          if (val) {
            // Create the display block if it was not rendered
            if (!descDisplay) {
              const block = document.getElementById('desc-block');
              const div = document.createElement('div');
              div.className = 'desc-display';
              div.id = 'desc-display';
              div.innerHTML = '<p class="desc-text" id="desc-text"></p>' +
                '<button class="desc-edit-btn" id="desc-edit-btn" title="Edit"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Edit</button>';
              if (descEditor) block.insertBefore(div, descEditor);
              div.querySelector('.desc-edit-btn').addEventListener('click', showEditor);
              div.querySelector('.desc-text').textContent = val;
              if (descEditor) descEditor.style.display = 'none';
              // Add cancel button if not present
              if (!document.getElementById('desc-cancel-btn') && descEditor) {
                const cancelBtn = document.createElement('button');
                cancelBtn.className = 'btn btn-sm';
                cancelBtn.id = 'desc-cancel-btn';
                cancelBtn.textContent = 'Cancel';
                cancelBtn.addEventListener('click', () => {
                  descEditor.style.display = 'none';
                  div.style.display = '';
                });
                descEditor.querySelector('.desc-editor-actions').appendChild(cancelBtn);
              }
            } else {
              showDisplay(val);
            }
          } else {
            // Description cleared — stay in editor mode
            if (descDisplay) descDisplay.style.display = 'none';
          }
          btnSaveDesc.textContent = '✓ Saved';
          setTimeout(() => { btnSaveDesc.disabled = false; btnSaveDesc.textContent = 'Save'; }, 2000);
        }
      }).catch(() => { btnSaveDesc.disabled = false; });
    });
  }

  // Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT' || e.target.tagName === 'TEXTAREA') return;
    switch (e.key.toLowerCase()) {
      case 'f': e.preventDefault(); toggleFav(); break;
      case 'w': e.preventDefault(); toggleWl(); break;
      case 'n': e.preventDefault(); goNext(); break;
      case 'm': e.preventDefault(); cycleAutoplay(); break;
      case 'l': e.preventDefault(); art.fullscreen = !art.fullscreen; break;
      case 't': if (CAN_WRITE && tagInput) { e.preventDefault(); tagInput.focus(); } break;
    }
  });
</script>

<%- include('partials/footer') %>
