<%- include('partials/header') %>

<div class="page-header">
  <h1>Administration</h1>
</div>

<% if (success) { %>
  <div class="alert alert-success"><%= success %></div>
<% } %>
<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<div class="card">
  <h2>Create a user</h2>
  <form method="POST" action="/admin/users/create" class="form-inline">
    <div class="form-group">
      <input type="text" name="username" placeholder="Username" required minlength="2" maxlength="50">
    </div>
    <div class="form-group">
      <input type="password" name="password" placeholder="Password" required minlength="4">
    </div>
    <div class="form-group">
      <select name="role">
        <option value="user">User</option>
        <option value="admin">Admin</option>
      </select>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
  </form>
</div>

<%
function formatSize(bytes) {
  bytes = Number(bytes);
  if (!bytes || Number.isNaN(bytes)) return '—';
  const units = ['B', 'KB', 'MB', 'GB', 'TB'];
  let i = 0;
  let size = Number(bytes);
  while (size >= 1024 && i < units.length - 1) { size /= 1024; i++; }
  return size.toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
}
function formatDurationShort(seconds) {
  if (!seconds) return '—';
  const h = Math.floor(seconds / 3600);
  const m = Math.floor((seconds % 3600) / 60);
  if (h > 0) return h + 'h ' + String(m).padStart(2, '0') + 'm';
  return m + 'min';
}
%>

<div class="card">
  <h2>Users (<%= users.length %>)</h2>
  <table class="video-table">
    <thead>
      <tr>
        <th>Username</th>
        <th>Status</th>
        <th>Role</th>
        <th>Libraries</th>
        <th>Last sign-in</th>
        <th>Registered</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% for (const u of users) { %>
        <tr<%= u.is_active === 0 ? ' style="opacity:0.5"' : '' %>>
          <td><%= u.username %></td>
          <td>
            <% if (u.id !== user.id) { %>
              <form method="POST" action="/admin/users/<%= u.id %>/toggle-active" style="display:inline">
                <button type="submit" class="btn btn-sm <%= u.is_active ? 'btn-active' : 'btn-danger' %>" style="min-width:70px">
                  <%= u.is_active ? 'Active' : 'Disabled' %>
                </button>
              </form>
            <% } else { %>
              <span class="badge badge-success">Active</span>
            <% } %>
          </td>
          <td>
            <% if (u.id !== user.id) { %>
              <form method="POST" action="/admin/users/<%= u.id %>/role" style="display:inline">
                <select name="role" onchange="this.form.submit()" class="autoplay-select">
                  <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>User</option>
                  <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                </select>
              </form>
            <% } else { %>
              <span class="badge badge-accent">Admin (you)</span>
            <% } %>
          </td>
          <td><%= u.library_count %></td>
          <td class="muted"><%= u.last_login_at ? new Date(u.last_login_at).toLocaleString('en-GB') : 'Never' %></td>
          <td class="muted"><%= new Date(u.created_at).toLocaleDateString('en-GB') %></td>
          <td>
            <% if (u.id !== user.id) { %>
              <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap">
                <form method="POST" action="/admin/users/<%= u.id %>/force-logout" style="display:inline">
                  <button type="submit" class="btn btn-sm" title="Sign this user out">Sign out</button>
                </form>
                <button type="button" class="btn btn-sm" onclick="this.nextElementSibling.style.display='flex'">Password</button>
                <form method="POST" action="/admin/users/<%= u.id %>/password" style="display:none;gap:0.5rem;align-items:center">
                  <input type="password" name="password" placeholder="New password" required style="width:150px;padding:0.3rem 0.5rem;background:var(--bg-primary);border:1px solid var(--border);border-radius:var(--radius);color:var(--text-primary);font-size:0.8rem">
                  <button type="submit" class="btn btn-sm btn-primary">OK</button>
                </form>
                <form method="POST" action="/admin/users/<%= u.id %>/delete" style="display:inline"
                      onsubmit="return confirm('Delete <%= u.username %>&apos;s account? All of their data will be erased.')">
                  <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
              </div>
            <% } %>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<!-- Per-user stats -->
<div class="card">
  <h2>Per-user statistics</h2>
  <table class="video-table">
    <thead>
      <tr>
        <th>User</th>
        <th>Videos in their libraries</th>
        <th>Disk used</th>
        <th>Videos watched</th>
        <th>Favourites</th>
        <th>Playlists</th>
        <th>Watch time</th>
      </tr>
    </thead>
    <tbody>
      <% for (const u of users) {
        const s = userStatsMap[u.id] || {};
      %>
        <tr>
          <td><%= u.username %></td>
          <td class="muted"><%= Number(s.video_count) || 0 %></td>
          <td><%= formatSize(s.total_size) %></td>
          <td class="muted"><%= Number(s.watched_count) || 0 %></td>
          <td class="muted"><%= Number(s.favorite_count) || 0 %></td>
          <td class="muted"><%= Number(s.playlist_count) || 0 %></td>
          <td class="muted"><%= formatDurationShort(s.total_watch_time) %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<!-- Disk usage per library -->
<div class="card">
  <h2>Disk usage by library</h2>
  <% if (libStats.length === 0) { %>
    <p class="text-muted">No libraries.</p>
  <% } else { %>
    <table class="video-table">
      <thead>
        <tr>
          <th>Library</th>
          <th>Owner</th>
          <th>Videos</th>
          <th>Size</th>
          <th>Duration</th>
        </tr>
      </thead>
      <tbody>
        <% for (const lib of libStats) { %>
          <tr>
            <td><a href="/libraries/<%= lib.id %>" style="color:var(--accent)"><%= lib.name %></a></td>
            <td class="muted"><%= lib.owner %></td>
            <td class="muted"><%= lib.video_count %></td>
            <td><%= formatSize(lib.total_size) %></td>
            <td class="muted"><%= formatDurationShort(lib.total_duration) %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="card">
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;">
    <h2 style="margin:0;">Job queue
      <span class="text-muted" style="font-size:0.85rem; font-weight:400; margin-left:0.5rem;">
        <% for (const s of jobStats) { %>
          <span class="badge <%= s.status === 'processing' ? 'badge-accent' : s.status === 'pending' ? 'badge-info' : s.status === 'failed' ? 'badge-danger' : 'badge-success' %>"><%= s.count %> <%= s.status %></span>
        <% } %>
      </span>
    </h2>
    <div style="display:flex;gap:0.5rem;">
      <% const failedCount = jobStats.find(s => s.status === 'failed'); %>
      <% const processingCount = jobStats.find(s => s.status === 'processing'); %>
      <% if (failedCount && failedCount.count > 0) { %>
        <form method="POST" action="/admin/jobs/requeue-failed" style="display:inline">
          <button type="submit" class="btn btn-sm btn-primary" onclick="return confirm('Requeue the <%= failedCount.count %> failed job(s)?')">Requeue failed (<%= failedCount.count %>)</button>
        </form>
      <% } %>
      <% if (processingCount && processingCount.count > 0) { %>
        <form method="POST" action="/admin/jobs/requeue-stuck" style="display:inline">
          <button type="submit" class="btn btn-sm" onclick="return confirm('Requeue the jobs stuck in processing?')">Requeue stuck</button>
        </form>
      <% } %>
    </div>
  </div>
  <% if (jobs.length === 0) { %>
    <p class="text-muted">No jobs queued.</p>
  <% } else { %>
    <table class="video-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Video</th>
          <th>Library</th>
          <th>Status</th>
          <th>Created</th>
          <th>Error</th>
        </tr>
      </thead>
      <tbody>
        <% for (const j of jobs) { %>
          <tr>
            <td class="muted"><%= j.id %></td>
            <td style="max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= j.filename %>"><%= j.filename %></td>
            <td class="muted" style="max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= j.library_name %>"><%= j.library_name %></td>
            <td>
              <span class="badge <%= j.status === 'processing' ? 'badge-accent' : j.status === 'pending' ? 'badge-info' : j.status === 'failed' ? 'badge-danger' : 'badge-success' %>"><%= j.status %></span>
            </td>
            <td class="muted"><%= new Date(j.created_at).toLocaleString('en-GB') %></td>
            <td class="muted" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= j.error || '' %>"><%= j.error || '—' %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="card">
  <h2>Audit log</h2>
  <% if (auditLogs.length === 0) { %>
    <p class="text-muted">No actions recorded.</p>
  <% } else { %>
    <table class="video-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Admin</th>
          <th>Action</th>
          <th>Details</th>
        </tr>
      </thead>
      <tbody>
        <% for (const log of auditLogs) { %>
          <tr>
            <td class="muted"><%= new Date(log.created_at).toLocaleString('en-GB') %></td>
            <td><%= log.admin_username %></td>
            <td>
              <span class="badge <%= log.action === 'delete_user' ? 'badge-danger' : log.action === 'change_role' ? 'badge-accent' : log.action === 'reset_password' ? 'badge-info' : 'badge-success' %>"><%= log.action.replace(/_/g, ' ') %></span>
            </td>
            <td class="muted"><%= log.details || '—' %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('partials/footer') %>
