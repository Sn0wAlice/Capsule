<%- include('partials/header') %>

<div class="page-header">
  <h1>Settings</h1>
</div>

<% if (success) { %>
  <div class="alert alert-success"><%= success %></div>
<% } %>
<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<div class="settings-grid">
  <!-- Appearance -->
  <div class="card">
    <h2>Appearance</h2>
    <div class="setting-row">
      <div class="setting-info">
        <span class="setting-label">Default view</span>
        <span class="setting-desc">How videos are displayed inside libraries</span>
      </div>
      <div class="setting-control">
        <select id="setting-default-view" class="autoplay-select">
          <option value="grid" <%= user.default_view === 'grid' ? 'selected' : '' %>>Grid</option>
          <option value="list" <%= user.default_view === 'list' ? 'selected' : '' %>>List</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Account -->
  <div class="card">
    <h2>Account</h2>
    <form method="POST" action="/settings/username">
      <div class="setting-row" style="flex-direction: column; align-items: stretch; gap: 0.75rem;">
        <span class="setting-label">Username</span>
        <div class="form-group">
          <input type="text" name="username" value="<%= user.username %>" minlength="2" maxlength="50" required>
        </div>
        <button type="submit" class="btn btn-sm btn-primary">Update</button>
      </div>
    </form>
    <form method="POST" action="/settings/password">
      <div class="setting-row" style="flex-direction: column; align-items: stretch; gap: 0.75rem;">
        <span class="setting-label">Change password</span>
        <div class="form-group">
          <input type="password" name="current" placeholder="Current password" required>
        </div>
        <div class="form-group">
          <input type="password" name="password" placeholder="New password" required>
        </div>
        <div class="form-group" style="margin-bottom: 0">
          <input type="password" name="confirm" placeholder="Confirm" required>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Update</button>
      </div>
    </form>
  </div>
</div>

<script>
  // Default view
  document.getElementById('setting-default-view').addEventListener('change', (e) => {
    fetch('/settings/default-view', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ view: e.target.value }),
    });
  });
</script>

<%- include('partials/footer') %>
