<% } %>

<!-- Watchlist -->
<% if (watchlist.length > 0) { %>
  <div class="dashboard-section">
    <h2 class="section-title">Watchlist</h2>
    <div class="video-grid">
      <% for (const v of watchlist) { %>
        <a href="/videos/<%= v.id %>" class="video-card">
