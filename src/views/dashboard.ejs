<!-- Add library -->
<div class="card">
  <h2>Add a library</h2>
  <form method="POST" action="/libraries/add" class="form-inline">
    <div class="form-group">
      <input type="text" name="name" placeholder="Library name" required>
    </div>
    <div class="form-group">
      <input type="text" name="path" placeholder="Folder path (e.g. /media/movies)" required>
    </div>
    <button type="submit" class="btn btn-primary">Add</button>
  </form>
</div>

<!-- My libraries -->
<% if (libraries.length === 0 && sharedLibraries.length === 0) { %>
  <div class="empty-state">
    <p>No libraries yet. Add one to get started.</p>
  </div>
<% } %>

<% if (libraries.length > 0) { %>
  <div class="dashboard-section">
    <h2 class="section-title">My libraries</h2>
    <div class="libraries-grid">
      <% for (const lib of libraries) { %>
        <div class="card library-card">
          <% if (lib.cover_vid) { %>
            <a href="/libraries/<%= lib.id %>" class="library-cover">
              <img src="/videos/<%= lib.cover_vid %>/thumb" alt="" loading="lazy" decoding="async">
            </a>
          <% } %>
          <div class="library-info">
            <h3><a href="/libraries/<%= lib.id %>"><%= lib.name %></a></h3>
            <p class="library-path"><%= lib.path %></p>
            <p class="library-count"><%= lib.video_count || 0 %> video(s) <% if (!lib.video_count) { %><span class="badge badge-info">Not scanned yet</span><% } %></p>
          </div>
          <div class="library-actions">
            <a href="/libraries/<%= lib.id %>" class="btn btn-sm">Browse</a>
            <form method="POST" action="/libraries/<%= lib.id %>/scan" style="display:inline">
              <button type="submit" class="btn btn-sm btn-primary">Scan</button>
            </form>
            <button type="button" class="btn btn-sm" onclick="openEditModal(<%= lib.id %>, '<%= lib.name.replace(/'/g, "\\'") %>', '<%= lib.path.replace(/'/g, "\\'") %>')">Edit</button>
            <button type="button" class="btn btn-sm" onclick="openShareModal(<%= lib.id %>, '<%= lib.name.replace(/'/g, "\\'") %>')">Share</button>
            <form method="POST" action="/libraries/<%= lib.id %>/delete" style="display:inline"
                  onsubmit="return confirm('Delete this library?')">
              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
          </div>
        </div>
      <% } %>
    </div>
  </div>
<% } %>

<!-- Shared with me -->
<% if (sharedLibraries.length > 0) { %>
  <div class="dashboard-section">
    <h2 class="section-title">Shared with me</h2>
    <div class="libraries-grid">
      <% for (const lib of sharedLibraries) { %>
        <div class="card library-card">
          <% if (lib.cover_vid) { %>
            <a href="/libraries/<%= lib.id %>" class="library-cover">
              <img src="/videos/<%= lib.cover_vid %>/thumb" alt="" loading="lazy" decoding="async">
            </a>
          <% } %>
          <div class="library-info">
            <h3><a href="/libraries/<%= lib.id %>"><%= lib.name %></a></h3>
            <p class="library-path"><%= lib.owner_name %> &mdash; <span class="badge <%= lib.permission === 'write' ? 'badge-success' : 'badge-info' %>"><%= lib.permission === 'write' ? 'Read/Write' : 'Read' %></span></p>
            <p class="library-count"><%= lib.video_count || 0 %> video(s)</p>
          </div>
          <div class="library-actions">
            <a href="/libraries/<%= lib.id %>" class="btn btn-sm">Browse</a>
            <% if (lib.permission === 'write') { %>
              <form method="POST" action="/libraries/<%= lib.id %>/scan" style="display:inline">
                <button type="submit" class="btn btn-sm btn-primary">Scan</button>
              </form>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
<% } %>

<!-- Edit Library Modal -->
<div class="modal-overlay" id="edit-modal" style="display:none">
  <div class="modal-content">
    <div class="modal-header">
      <h2>Edit library</h2>
      <button class="modal-close" onclick="closeEditModal()">&times;</button>
    </div>
    <div class="modal-body">
      <form method="POST" id="edit-lib-form" action="">
        <div class="form-group" style="margin-bottom:0.75rem">
          <label style="display:block;margin-bottom:0.25rem;font-size:0.85rem;opacity:0.7">Name</label>
          <input type="text" name="name" id="edit-lib-name" required style="width:100%">
        </div>
        <div class="form-group" style="margin-bottom:1rem">
          <label style="display:block;margin-bottom:0.25rem;font-size:0.85rem;opacity:0.7">Path (leave empty to keep it)</label>
          <input type="text" name="path" id="edit-lib-path" placeholder="New path…" style="width:100%">
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <button type="button" class="btn" onclick="closeEditModal()">Cancel</button>
      </form>
    </div>
  </div>
</div>

<!-- Share Modal -->
<div class="modal-overlay" id="share-modal" style="display:none">
  <div class="modal-content">
    <div class="modal-header">
      <h2>Share: <span id="share-lib-name"></span></h2>
      <button class="modal-close" onclick="closeShareModal()">&times;</button>
    </div>
    <div class="modal-body">
      <div id="share-list"></div>
      <div class="share-add-form">
        <select id="share-user-select">
          <option value="">Choose a user…</option>
        </select>
        <select id="share-perm-select">
          <option value="read">Read</option>
          <option value="write">Read/Write</option>
        </select>
        <button class="btn btn-primary btn-sm" id="share-add-btn">Add</button>
      </div>
    </div>
  </div>
</div>

<script>
// Edit library modal
function openEditModal(libId, libName, libPath) {
  document.getElementById('edit-lib-form').action = '/libraries/' + libId + '/edit';
  document.getElementById('edit-lib-name').value = libName;
  document.getElementById('edit-lib-path').value = '';
  document.getElementById('edit-lib-path').placeholder = libPath;
  document.getElementById('edit-modal').style.display = 'flex';
}
function closeEditModal() {
  document.getElementById('edit-modal').style.display = 'none';
}
document.getElementById('edit-modal').addEventListener('click', (e) => {
  if (e.target.id === 'edit-modal') closeEditModal();
});

let currentShareLibId = null;

function openShareModal(libId, libName) {
  currentShareLibId = libId;
  document.getElementById('share-lib-name').textContent = libName;
  document.getElementById('share-modal').style.display = 'flex';
  loadShares(libId);
}

function closeShareModal() {
  document.getElementById('share-modal').style.display = 'none';
  currentShareLibId = null;
}

function loadShares(libId) {
  fetch('/libraries/' + libId + '/shares')
    .then(r => r.json())
    .then(data => {
      const list = document.getElementById('share-list');
      list.innerHTML = '';
      for (const s of data.shares) {
        const div = document.createElement('div');
        div.className = 'share-row';

        const nameSpan = document.createElement('span');
        nameSpan.className = 'share-username';
        nameSpan.textContent = s.username;

        const badgeSpan = document.createElement('span');
        badgeSpan.className = 'badge ' + (s.permission === 'write' ? 'badge-success' : 'badge-info');
        badgeSpan.textContent = s.permission === 'write' ? 'Read/Write' : 'Read';

        const removeBtn = document.createElement('button');
        removeBtn.className = 'btn btn-sm btn-danger';
        removeBtn.textContent = 'Remove';
        removeBtn.addEventListener('click', () => removeShare(libId, s.id));

        div.appendChild(nameSpan);
        div.appendChild(badgeSpan);
        div.appendChild(removeBtn);
        list.appendChild(div);
      }
      if (data.shares.length === 0) {
        const p = document.createElement('p');
        p.className = 'text-muted';
        p.textContent = 'Not shared with anyone';
        list.appendChild(p);
      }

      const sharedUserIds = new Set(data.shares.map(s => s.user_id));
      const select = document.getElementById('share-user-select');
      select.textContent = '';
      const defaultOpt = document.createElement('option');
      defaultOpt.value = '';
      defaultOpt.textContent = 'Choose a user…';
      select.appendChild(defaultOpt);
      for (const u of data.users) {
        if (!sharedUserIds.has(u.id)) {
          const opt = document.createElement('option');
          opt.value = u.id;
          opt.textContent = u.username;
          select.appendChild(opt);
        }
      }
    });
}

document.getElementById('share-add-btn').addEventListener('click', () => {
  const userId = document.getElementById('share-user-select').value;
  const perm = document.getElementById('share-perm-select').value;
  if (!userId || !currentShareLibId) return;
  fetch('/libraries/' + currentShareLibId + '/shares', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ user_id: userId, permission: perm }),
  }).then(r => r.json()).then(() => loadShares(currentShareLibId));
});

function removeShare(libId, shareId) {
  fetch('/libraries/' + libId + '/shares/' + shareId + '/delete', { method: 'POST' })
    .then(r => r.json())
    .then(() => loadShares(libId));
}

document.getElementById('share-modal').addEventListener('click', (e) => {
  if (e.target.id === 'share-modal') closeShareModal();
});
</script>

<%- include('partials/footer') %>
